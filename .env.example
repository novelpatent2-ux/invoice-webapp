# Copy this file to .env for local testing (never commit the real .env file).
# In production (Railway, Render, etc.) you'll set these as environment
# variables in that platform's dashboard instead of using a file.

# The password you'll type in to log in to the app.
APP_PASSWORD=choose-a-strong-password-here

# Any long random string — used only to sign the login cookie.
# You can generate one at https://1password.com/password-generator/
# or just mash the keyboard for 40+ characters.
SESSION_SECRET=change-this-to-a-long-random-string

# Your Postgres connection string from Supabase (Project Settings -> Database -> Connection string -> URI).
DATABASE_URL=postgresql://user:password@host:5432/postgres
